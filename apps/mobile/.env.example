# Copy to .env and fill in your values
# These are EXPO_PUBLIC_ variables — safe to expose to the client bundle

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLIC_KEY=your-anon-public-key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
EXPO_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_xxx

# EAS project ID (from `eas build:configure`)
EAS_PROJECT_ID=your-eas-project-uuid
